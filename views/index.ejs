<div class="row mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm bg-primary text-white">
      <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
        <div>
          <h1 class="h3 mb-1"><i class="bi bi-calendar-event"></i> Próximas Restrições</h1>
          <p class="mb-0 opacity-75">
            Mostrando restrições para os próximos <strong><%= diasFuturos %></strong> dias
          </p>
        </div>
        <div class="text-end">
          <span class="badge bg-light text-primary fs-6">
            <i class="bi bi-list-check"></i> <%= totalRestricoes %> ocorrências
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filtro de dias -->
<div class="row mb-3">
  <div class="col-12">
    <div class="btn-group" role="group">
      <a href="/?dias=7" class="btn btn-outline-primary <%= diasFuturos === 7 ? 'active' : '' %>">7 dias</a>
      <a href="/?dias=30" class="btn btn-outline-primary <%= diasFuturos === 30 ? 'active' : '' %>">30 dias</a>
      <a href="/?dias=60" class="btn btn-outline-primary <%= diasFuturos === 60 ? 'active' : '' %>">60 dias</a>
      <a href="/?dias=120" class="btn btn-outline-primary <%= diasFuturos === 120 ? 'active' : '' %>">120 dias</a>
    </div>
  </div>
</div>

<% if (grupos.length === 0) { %>
  <div class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> Nenhuma restrição encontrada para o período selecionado.
  </div>
<% } %>

<div class="row g-3">
  <% grupos.forEach((grupo, idx) => { %>
    <div class="col-12">
      <div class="card shadow-sm <%= grupo.isHoje ? 'border-danger border-3' : 'border-0' %> <%= idx > 0 && !grupo.isHoje ? 'opacity-75' : '' %>">
        <div class="card-header <%= grupo.isHoje ? 'bg-danger text-white' : 'bg-secondary text-white' %> d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="bi bi-calendar3"></i>
            <%= formatarData(grupo.data) %>
            <% if (grupo.isHoje) { %>
              <span class="badge bg-light text-danger ms-2">HOJE</span>
            <% } %>
          </h5>
          <span class="badge bg-light text-dark"><%= grupo.itens.length %> restrição(ões)</span>
        </div>
        <div class="card-body p-0">
          <% grupo.itens.forEach((item, i) => { %>
            <div class="p-3 <%= i > 0 ? 'border-top' : '' %>">
              <h6 class="text-primary mb-2">
                <% if (item.generico) { %>
                  <i class="bi bi-repeat"></i>
                <% } else { %>
                  <i class="bi bi-pin-angle"></i>
                <% } %>
                <%= item.titulo %>
              </h6>

              <% if (item.excecao) { %>
                <div class="alert alert-warning py-1 px-2 small mb-2">
                  <i class="bi bi-exclamation-triangle"></i> <%= item.excecao %>
                </div>
              <% } %>

              <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Estrada</th>
                      <th>Início (PK / Local)</th>
                      <th>Fim (PK / Local)</th>
                      <th>Duração</th>
                      <th>Sentido</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% item.estradas.forEach(e => { %>
                      <tr>
                        <td><span class="badge bg-dark"><%= e.ctra %></span></td>
                        <td><small><%= e.inicio.pk %> — <%= e.inicio.pop %></small></td>
                        <td><small><%= e.fim.pk %> — <%= e.fim.pop %></small></td>
                        <td><span class="badge bg-warning text-dark"><%= e.duracao %></span></td>
                        <td><small><%= e.sentido %></small></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="row mt-4">
  <div class="col-12">
    <div class="alert alert-secondary small mb-0">
      <i class="bi bi-info-circle"></i>
      <strong>Nota:</strong> As restrições genéricas (todas as sextas, sábados, domingos, etc.) são calculadas
      automaticamente para cada data futura. Verifique sempre a legislação vigente.
    </div>
  </div>
</div>